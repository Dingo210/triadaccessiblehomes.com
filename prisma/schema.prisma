generator client {
    provider = "prisma-client-js"
    // "native" covers local dev; "rhel-openssl-3.0.x" is the Vercel serverless
    // (AWS Lambda / Amazon Linux) runtime target.
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Business {
  id                   String    @id @default(cuid())
  name                 String
  category             String
  categorySlug         String
  description          String
  address              String    @default("")
  phone                String    @default("")
  email                String    @default("")
  website              String    @default("")
  photoUrl             String    @default("")
  featured             Boolean   @default(false)
  featuredUntil        DateTime?
  stripeSubscriptionId String?
  stripeCustomerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([categorySlug])
  @@index([featured])
}

/// First-party, cookieless analytics: pageviews and provider contact clicks.
/// No IP, user agent, or cookie is stored — `visitorHash` is a salted hash that
/// rotates daily (see lib/analytics.ts). Additive table; nothing references it.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // pageview | phone_click | email_click | website_click
  businessId  String?  // set for listing pageviews and contact clicks
  path        String   @default("")
  referrer    String   @default("") // external referrer hostname only
  visitorHash String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([businessId, createdAt])
}
